s Flintsbach\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"{{ 'b2b-logo-4AM.png' | asset_url }}\" alt=\"4:AM\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"{{ 'b2b-logo-fillhub.png' | asset_url }}\" alt=\"Fillhub\" decoding=\"async\"></div>\n    </div>\n    <div class=\"b2b-partner__gruppe\" aria-hidden=\"true\">\n      <div class=\"b2b-partner__logo\"><img src=\"https://cdn.shopify.com/s/files/1/0615/5485/2024/files/Sparkasse_Logo.png?v=1773385615\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"https://cdn.shopify.com/s/files/1/0615/5485/2024/files/VR_Bank_Logo.webp?v=1773385615\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"https://cdn.shopify.com/s/files/1/0615/5485/2024/files/Logo-2026.png?v=1773385931\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"https://cdn.shopify.com/s/files/1/0615/5485/2024/files/Auerbraeu_Logo.svg?v=1773385615\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"https://cdn.shopify.com/s/files/1/0615/5485/2024/files/ovbmedia-logo_2.jpg?v=1773385617\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"https://cdn.shopify.com/s/files/1/0615/5485/2024/files/1762349249219_image.png?v=1773385615\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"https://cdn.shopify.com/s/files/1/0615/5485/2024/files/LOGO-GANG-schwarz.svg?v=1777292138\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"{{ 'b2b-logo-naturyoga.png' | asset_url }}\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"{{ 'b2b-logo-nett-niedlich.png' | asset_url }}\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"{{ 'b2b-logo-mutte-huette.png' | asset_url }}\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"{{ 'b2b-logo-lho.png' | asset_url }}\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"{{ 'b2b-logo-4AM.png' | asset_url }}\" alt=\"\" decoding=\"async\"></div>\n      <div class=\"b2b-partner__logo\"><img src=\"{{ 'b2b-logo-fillhub.png' | asset_url }}\" alt=\"\" decoding=\"async\"></div>\n    </div>\n    </div>\n  </div>\n</div>\n<style>\n  .b2b-partner { padding: 24px 0; overflow: hidden; }\n  .b2b-partner__band { overflow: hidden; -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent); mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent); }\n  .b2b-partner__spur { display: flex; width: max-content; animation: b2b-partner-lauf 65s linear infinite; }\n  .b2b-partner__band:hover .b2b-partner__spur, .b2b-partner__spur:focus-within { animation-play-state: paused; }\n  .b2b-partner__gruppe { display: flex; align-items: center; gap: 56px; padding-right: 56px; }\n  .b2b-partner__logo { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 170px; height: 64px; }\n  .b2b-partner__logo img { width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; }\n  @keyframes b2b-partner-lauf { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n  @media screen and (max-width: 767px) {\n    .b2b-partner { padding: 16px 0; }\n    .b2b-partner__gruppe { gap: 32px; padding-right: 32px; }\n    .b2b-partner__logo { width: 120px; height: 40px; }\n    .b2b-partner__logo img { max-width: 100%; max-height: 100%; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .b2b-partner__spur { animation: none; }\n    .b2b-partner__band { overflow-x: auto; }\n  }\n</style>",
