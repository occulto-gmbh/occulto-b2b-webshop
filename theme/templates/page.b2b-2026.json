    "hero": {
      "type": "b2b-abschnitt",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Der Hero des Hauptshops ist dort ein slideshow-Abschnitt mit Videoblock.\n  Trade hat zwar auch eine slideshow, aber ohne Video, ohne Farbverlauf und\n  mit nur einem Knopf - deshalb hier als eigener Block nachgebaut.\n\n  Alle Zahlen stammen aus einer Messung der Livefassung:\n  Buehne clamp(30rem, 125vw, 42rem), Inhalt links im Raster mit dem\n  Seitenabstand des Themes, Ueberschrift clamp(34px, 4.8vw, 68px).\n{%- endcomment -%}\n<section class=\"b2b-hero\" id=\"b2b-hero\">\n  <video class=\"b2b-hero__video\" autoplay muted loop playsinline preload=\"metadata\"\n    poster=\"https://www.occulto.de/cdn/shop/files/preview_images/dec801fe9d6643c29bea41f0138858e3.thumbnail.0000000000_400x.jpg?v=1757513809\">\n    <source src=\"https://www.occulto.de/cdn/shop/videos/c/vp/dec801fe9d6643c29bea41f0138858e3/dec801fe9d6643c29bea41f0138858e3.HD-1080p-7.2Mbps-57188294.mp4\" type=\"video/mp4\">\n  </video>\n  <span class=\"b2b-hero__schleier\" aria-hidden=\"true\"></span>\n\n  <div class=\"b2b-hero__inhalt\">\n    <p class=\"b2b-hero__zeile\">Ab 1,69 &euro; pro Paar | ab 100 Paar</p>\n    <h1 class=\"b2b-hero__titel\">\n      <strong>Socken &amp; Merch in</strong><strong>deinem Design</strong><em>Kostenloser Designvorschlag von uns &ndash; jetzt unverbindlich anfragen</em>\n    </h1>\n    <div class=\"b2b-hero__knoepfe\">\n      <a class=\"b2b-hero__knopf b2b-hero__knopf--dunkel\" href=\"#b2b-anfrage\">Unverbindlich anfragen</a>\n      <a class=\"b2b-hero__knopf b2b-hero__knopf--hell\" href=\"#b2b-konfigurator\">Socken Konfigurator</a>\n    </div>\n  </div>\n\n  <button type=\"button\" class=\"b2b-hero__weiter\" data-weiter aria-label=\"Zum n&auml;chsten Abschnitt\">\n    <svg viewBox=\"0 0 18 16\" width=\"18\" height=\"16\" fill=\"none\" aria-hidden=\"true\"><path d=\"m1 4 8 8 8-8\" stroke=\"currentColor\" stroke-linecap=\"square\"/></svg>\n  </button>\n</section>\n<style>\n  /* Die Buehne. Auf dem Handy 480, auf dem Schreibtisch 672 Bildpunkte -\n     dazwischen waechst sie mit der Fensterbreite. */\n  .b2b-hero {\n    position: relative;\n    display: grid;\n    align-items: center;\n    /* In Bildpunkten, nicht in rem: Trade setzt die Wurzelschrift auf 10px,\n       dort waere 30rem nur 300 statt 480. */\n    min-height: clamp(480px, 125vw, 672px);\n    /* Der Seitenabstand sitzt auf der Buehne, nicht auf dem Textblock:\n       ein Block mit Breite 100% und zusaetzlichem Aussenabstand waere\n       breiter als das Fenster. Video und Schleier stoert das nicht, ein\n       absolut gesetztes inset:0 deckt die Polsterbox mit ab. */\n    padding-inline: 20px;\n    overflow: hidden;\n    background: rgb(var(--b2b-tinte, 46 46 45));\n  }\n\n  .b2b-hero__video {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    /* Der untere Bildrand traegt das Motiv - oben wird beschnitten. */\n    object-position: center bottom;\n  }\n\n  /* Der Verlauf dunkelt nur die linke Haelfte ab, damit die Schrift steht\n     und das Video rechts frei bleibt. */\n  .b2b-hero__schleier {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to right, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.45) 38%, rgba(0,0,0,0) 72%);\n  }\n\n  .b2b-hero__inhalt {\n    position: relative;\n    justify-self: start;\n    width: 100%;\n    max-width: 700px;\n    color: rgb(255 255 255);\n    text-align: left;\n  }\n\n  .b2b-hero__zeile {\n    margin: 0;\n    font-size: 14px;\n    line-height: 1.7;\n    letter-spacing: 0.02em;\n  }\n\n  .b2b-hero__titel {\n    margin: 16px 0 0;\n    font-size: clamp(34px, 4.8vw, 68px);\n    font-weight: 900;\n    line-height: 1.02;\n    text-transform: uppercase;\n    text-wrap: balance;\n  }\n\n  /* Die beiden strong sind die zwei Zeilen der Ueberschrift, das em ist der\n     Nachsatz darunter - kleiner, nicht kursiv, nicht in Versalien. */\n  .b2b-hero__titel strong {\n    display: block;\n    font-weight: inherit;\n  }\n\n  .b2b-hero__titel em {\n    display: block;\n    margin-top: 20px;\n    font-size: 17px;\n    font-style: normal;\n    font-weight: 700;\n    line-height: 1.3;\n    text-transform: none;\n  }\n\n  .b2b-hero__knoepfe {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 16px;\n    margin-top: 24px;\n  }\n\n  .b2b-hero__knopf {\n    display: inline-block;\n    padding: 11px 18px;\n    border: 1px solid transparent;\n    border-radius: 6px;\n    font-size: 14px;\n    font-weight: 700;\n    letter-spacing: 0.03em;\n    text-align: center;\n    text-decoration: none;\n    transition: background-color .18s ease, border-color .18s ease, color .18s ease, transform .2s, box-shadow .2s;\n  }\n\n  .b2b-hero__knopf--dunkel {\n    border-color: rgb(var(--b2b-tinte, 46 46 45));\n    background: rgb(var(--b2b-tinte, 46 46 45));\n    color: rgb(255 255 255);\n  }\n\n  .b2b-hero__knopf--hell {\n    border-color: rgb(255 255 255);\n    background: rgb(255 255 255);\n    color: rgb(var(--b2b-tinte, 46 46 45));\n  }\n\n  .b2b-hero__knopf:hover,\n  .b2b-hero__knopf:focus-visible {\n    border-color: rgb(var(--b2b-akzent, 199 42 9));\n    background: rgb(var(--b2b-akzent, 199 42 9));\n    color: rgb(255 255 255);\n    transform: translateY(-3px);\n    box-shadow: 0 10px 26px rgb(0 0 0 / .28);\n  }\n\n  /* Der Knopf haengt mittig an der Unterkante, zur Haelfte darunter. */\n  .b2b-hero__weiter {\n    position: absolute;\n    bottom: -25px;\n    left: 50%;\n    translate: -50% 0;\n    display: grid;\n    place-items: center;\n    width: 50px;\n    height: 50px;\n    padding: 0;\n    border: 1px solid rgb(255 255 255);\n    border-radius: 50%;\n    background: rgb(255 255 255);\n    color: rgb(var(--b2b-tinte, 46 46 45));\n    cursor: pointer;\n    transition: color .18s ease, border-color .18s ease;\n  }\n\n  .b2b-hero__weiter:hover,\n  .b2b-hero__weiter:focus-visible {\n    color: rgb(var(--b2b-akzent, 199 42 9));\n    border-color: rgb(var(--b2b-akzent, 199 42 9));\n  }\n\n  @media screen and (min-width: 700px) {\n    .b2b-hero { padding-inline: 32px; }\n  }\n\n  @media screen and (min-width: 768px) {\n    .b2b-hero__zeile { font-size: 17px; }\n    .b2b-hero__titel { margin-top: 20px; }\n    .b2b-hero__titel em { font-size: 22px; }\n    .b2b-hero__knoepfe { gap: 20px; margin-top: 32px; }\n    .b2b-hero__knopf { padding: 16px 34px; font-size: 17px; }\n  }\n\n  @media screen and (min-width: 1000px) {\n    .b2b-hero { padding-inline: 48px; }\n  }\n\n  /* Unter 768 stehen die Knoepfe untereinander ueber die volle Breite. */\n  @media screen and (max-width: 767px) {\n    .b2b-hero__knopf { width: 100%; }\n  }\n</style>\n<script>\n  (function () {\n    var knopf = document.querySelector('[data-weiter]');\n    if (!knopf) return;\n    knopf.addEventListener('click', function () {\n      var hier = knopf.closest('.shopify-section');\n      var naechster = hier && hier.nextElementSibling;\n      /* Ausgeblendete Abschnitte ueberspringen - sonst scrollt der Knopf\n         auf eine leere Stelle. */\n      while (naechster && !naechster.getBoundingClientRect().height) {\n        naechster = naechster.nextElementSibling;\n      }\n      if (naechster) naechster.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    });\n  })();\n</script>",
