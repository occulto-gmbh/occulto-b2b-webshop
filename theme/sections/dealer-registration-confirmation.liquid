{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    <div id="DealerConfirmationApproved" hidden>
      <h1 class="title">{{ 'templates.dealer_confirmation.already_approved_heading' | t }}</h1>
      <p>{{ 'templates.dealer_confirmation.already_approved_body' | t }}</p>
      <a href="{{ routes.account_url }}" class="button">{{ 'templates.dealer_confirmation.login_cta' | t }}</a>
    </div>
    <div id="DealerConfirmationPending">
      <h1 class="title">{{ 'templates.dealer_confirmation.pending_heading' | t }}</h1>
      <p>{{ 'templates.dealer_confirmation.pending_body' | t }}</p>
    </div>

    <script>
      (function () {
        var status = new URLSearchParams(window.location.search).get('status');
        if (status !== 'approved') return;
        document.getElementById('DealerConfirmationApproved').hidden = false;
        document.getElementById('DealerConfirmationPending').hidden = true;
      })();
    </script>
  </div>
</div>

{% schema %}
{
  "name": "Dealer confirmation",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Dealer confirmation"
    }
  ]
}
{% endschema %}
