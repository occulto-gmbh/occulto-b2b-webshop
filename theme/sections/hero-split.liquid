{% comment %}
  Split-Hero für die Startseite: Text/CTA auf einer festen Markenfarbfläche
  links, das echte Produktfoto großformatig rechts (statt in einen schmalen
  Wide-Banner hineingezwängt und dunkel überlagert zu werden, wie beim
  vorherigen `image-banner`). Nutzt bewusst ein reales Occulto-Produktfoto,
  keine KI-generierte Grafik (siehe ROADMAP.md: lokale KI-Bildgenerierung
  wurde bereits getestet und für Markenbilder verworfen).
{% endcomment %}

{{ 'section-hero-split.css' | asset_url | stylesheet_tag }}

<div class="hero-split color-{{ section.settings.color_scheme }}">
  <div class="hero-split__text{% if section.settings.text_image != blank %} hero-split__text--has-image{% endif %}">
    {%- if section.settings.text_image != blank -%}
      {{
        section.settings.text_image
        | image_url: width: 1200
        | image_tag:
          loading: 'eager',
          class: 'hero-split__text-bg',
          widths: '400,600,800,1200',
          sizes: '(min-width: 750px) 50vw, 100vw'
      }}
    {%- endif -%}
    <div class="hero-split__text-inner">
      {%- if section.settings.overline != blank -%}
        <p class="hero-split__overline caption-with-letter-spacing">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-split__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hero-split__body rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="button{% unless section.settings.button_style_secondary %} button--primary{% else %} button--secondary{% endunless %}"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
  {%- liquid
    assign media_tag = 'div'
    if section.settings.media_link != blank
      assign media_tag = 'a'
    endif
    assign has_media_overlay = false
    if section.settings.media_heading != blank or section.settings.media_button_label != blank
      assign has_media_overlay = true
    endif
  -%}
  <{{ media_tag }}
    class="hero-split__media{% if has_media_overlay %} hero-split__media--has-overlay{% endif %}"
    {% if media_tag == 'a' %}
      href="{{ section.settings.media_link }}"
    {% endif %}
  >
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero-split__image',
          widths: '400,600,800,1200,1600',
          sizes: '(min-width: 750px) 50vw, 100vw'
      }}
    {%- endif -%}
    {%- if has_media_overlay -%}
      <div class="hero-split__media-overlay color-{{ section.settings.color_scheme }}">
        {%- if section.settings.media_overline != blank -%}
          <p class="hero-split__overline caption-with-letter-spacing">{{ section.settings.media_overline }}</p>
        {%- endif -%}
        {%- if section.settings.media_heading != blank -%}
          <p class="hero-split__media-heading h3">{{ section.settings.media_heading }}</p>
        {%- endif -%}
        {%- if section.settings.media_button_label != blank -%}
          <span class="button button--primary hero-split__media-button">{{ section.settings.media_button_label }} &rarr;</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </{{ media_tag }}>
</div>

{% schema %}
{
  "name": "t:sections.hero-split.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero-split.settings.image.label"
    },
    {
      "type": "text",
      "id": "media_overline",
      "label": "t:sections.hero-split.settings.media_overline.label"
    },
    {
      "type": "text",
      "id": "media_heading",
      "label": "t:sections.hero-split.settings.media_heading.label"
    },
    {
      "type": "text",
      "id": "media_button_label",
      "label": "t:sections.hero-split.settings.media_button_label.label"
    },
    {
      "type": "url",
      "id": "media_link",
      "label": "t:sections.hero-split.settings.media_link.label"
    },
    {
      "type": "image_picker",
      "id": "text_image",
      "label": "t:sections.hero-split.settings.text_image.label"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "t:sections.hero-split.settings.overline.label",
      "default": "Willkommen, Handelspartner"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero-split.settings.heading.label",
      "default": "Occulto Händlerportal"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero-split.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero-split.settings.button_label.label",
      "default": "Produkte ansehen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero-split.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "t:sections.hero-split.settings.button_style_secondary.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-split.presets.name"
    }
  ]
}
{% endschema %}
