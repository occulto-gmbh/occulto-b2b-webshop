{% comment %}
  Split-Hero für die Startseite: Text/CTA auf einer festen Markenfarbfläche
  links, das echte Produktfoto großformatig rechts – nicht in einen schmalen,
  dunkel überlagerten Banner gezwängt. Nutzt bewusst ein reales Occulto-Produktfoto,
  keine KI-generierte Grafik (siehe ROADMAP.md: lokale KI-Bildgenerierung
  wurde bereits getestet und für Markenbilder verworfen).
{% endcomment %}

{{ 'section-hero-split.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign haendler = false
  if customer and customer.tags contains 'dealer-approved'
    assign haendler = true
  endif
  assign vororder_link = section.settings.vororder_link | default: '/pages/vororder'
-%}

{%- comment -%}
  Das Band ueber dem Hero: der naechste Vororder-Termin auf einen Blick.
  Darueber, nicht darunter: der Hero ist genau fensterhoch, ein Band darunter
  saehe man erst nach dem Scrollen. Das Messskript unten zieht es mit ab.
  Termin und Lieferung kommen aus b2b-vororder-termin, wie ueberall sonst.
{%- endcomment -%}
{%- if haendler and section.settings.vororder_band -%}
  <a class="hero-split__band" href="{{ vororder_link }}">
    <span class="hero-split__band-satz">&minus;10&nbsp;%</span>
    <span class="hero-split__band-text">
      Vororder bis <strong>{% render 'b2b-vororder-termin' %}</strong>, versandkostenfrei.
      Auslieferung ab {% render 'b2b-vororder-termin', teil: 'lieferung' %}.
    </span>
    <span class="hero-split__band-pfeil" aria-hidden="true">&rarr;</span>
  </a>
{%- endif -%}

<div class="hero-split color-{{ section.settings.color_scheme }}">
  <div class="hero-split__text{% if section.settings.text_image != blank %} hero-split__text--has-image{% endif %}">
    {%- if section.settings.text_image != blank -%}
      {{
        section.settings.text_image
        | image_url: width: 1200
        | image_tag:
          loading: 'eager',
          class: 'hero-split__text-bg',
          widths: '400,600,800,1200',
          sizes: '(min-width: 750px) 50vw, 100vw'
      }}
    {%- endif -%}
    <div class="hero-split__text-inner">
      {%- if section.settings.overline != blank -%}
        <p class="hero-split__overline caption-with-letter-spacing">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-split__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hero-split__body rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- comment -%}
        Zwei Knoepfe nebeneinander: der erste fuehrt ins Sortiment, der
        zweite zur Haendlerregistrierung. Die Reihe bricht auf schmalen
        Schirmen um, statt die Knoepfe zu stauchen.
      {%- endcomment -%}
      {%- liquid
        comment
          Freigeschaltete Haendler sehen statt "Haendler werden" den
          Vororder-Knopf: registrieren muessen sie sich nicht mehr, und Gaeste
          koennen keine Vororder abgeben.
        endcomment
        assign knopf_2 = section.settings.button_2_label
        if haendler and section.settings.button_2_link contains 'haendler-werden'
          assign knopf_2 = blank
        endif
        assign knopf_vororder = blank
        if haendler
          assign knopf_vororder = section.settings.vororder_label
        endif
      -%}
      {%- if section.settings.button_label != blank or knopf_2 != blank or knopf_vororder != blank -%}
        <div class="hero-split__buttons">
          {%- if section.settings.button_label != blank -%}
            <a
              href="{{ section.settings.button_link | default: '#' }}"
              class="button{% unless section.settings.button_style_secondary %} button--primary{% else %} button--secondary{% endunless %}"
            >
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if knopf_2 != blank -%}
            <a
              href="{{ section.settings.button_2_link | default: '#' }}"
              class="button{% if section.settings.button_2_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
            >
              {{ knopf_2 }}
            </a>
          {%- endif -%}
          {%- if knopf_vororder != blank -%}
            <a href="{{ vororder_link }}" class="button button--primary">
              {{ knopf_vororder | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
  <div class="hero-split__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero-split__image',
          widths: '400,600,800,1200,1600',
          sizes: '(min-width: 750px) 50vw, 100vw'
      }}
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    /* Wie viel ueber dem Hero steht, weiss nur der Browser: die Kopfzeile
       meldet ihre Hoehe zwar als --header-height, das Ankuendigungsband
       aber nicht. Gemessen wird deshalb der Hero selbst. */
    var hero = document.currentScript.previousElementSibling;
    if (!hero || !hero.classList.contains('hero-split')) {
      hero = document.querySelector('.hero-split');
    }
    if (!hero) return;

    function messen() {
      /* Erst den Deckel loesen, sonst misst man den eigenen Wert mit. */
      hero.style.setProperty('--b2b-hero-oben', '0px');
      var oben = hero.getBoundingClientRect().top + window.scrollY;
      hero.style.setProperty('--b2b-hero-oben', Math.round(Math.max(0, oben)) + 'px');
    }

    messen();
    window.addEventListener('resize', messen, { passive: true });
    window.addEventListener('load', messen);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(messen);
  })();
</script>

{% schema %}
{
  "name": "t:sections.hero-split.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero-split.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "text_image",
      "label": "t:sections.hero-split.settings.text_image.label"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "t:sections.hero-split.settings.overline.label",
      "default": "Willkommen, Handelspartner"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero-split.settings.heading.label",
      "default": "Occulto Händlerportal"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero-split.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero-split.settings.button_label.label",
      "default": "Produkte ansehen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero-split.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Beschriftung zweiter Knopf",
      "default": "Händler werden"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Ziel zweiter Knopf"
    },
    {
      "type": "checkbox",
      "id": "button_2_style_secondary",
      "label": "Zweiter Knopf zurückhaltend",
      "default": true
    },
    {
      "type": "header",
      "content": "Vororder (nur für freigeschaltete Händler)"
    },
    {
      "type": "text",
      "id": "vororder_label",
      "label": "Beschriftung Vororder-Knopf",
      "default": "Vororder −10 %",
      "info": "Leer lassen, um den Knopf auszublenden."
    },
    {
      "type": "url",
      "id": "vororder_link",
      "label": "Ziel Vororder",
      "info": "Leer = /pages/vororder"
    },
    {
      "type": "checkbox",
      "id": "vororder_band",
      "label": "Band mit Vororder-Termin über dem Hero",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "t:sections.hero-split.settings.button_style_secondary.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-split.presets.name"
    }
  ]
}
{% endschema %}
