{% comment %}
  Personalized greeting strip shown only to logged-in customers, with
  quick links to the actions a returning B2B dealer needs most (master-prompt
  section 51). Renders nothing for anonymous visitors.
{% endcomment %}

{{ 'section-customer-welcome-strip.css' | asset_url | stylesheet_tag }}

{%- if customer -%}
  {%- liquid
    assign welcome_name = customer.company.name | default: customer.first_name | default: customer.name
    assign is_german = true
    if localization.language.iso_code != 'de'
      assign is_german = false
    endif
  -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width customer-welcome-strip">
      <h2 class="customer-welcome-strip__heading">
        {%- if is_german -%}
          Willkommen zurück, {{ welcome_name }}
        {%- else -%}
          Welcome back, {{ welcome_name }}
        {%- endif -%}
      </h2>
      {%- comment -%}
        Die Wege, die ein wiederkehrender Haendler braucht. Bestellungen und
        Konto laufen ueber den Haendlerbereich (/pages/haendlerbereich): der
        zeigt die letzten Bestellungen mit "Nochmal bestellen" und verlinkt
        selbst auf Shopifys Kontoseite fuer Profil und Adressen.
      {%- endcomment -%}
      <div class="customer-welcome-strip__links">
        <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">
          {%- if is_german -%}Produkte ansehen{%- else -%}Browse products{%- endif -%}
        </a>
        <a href="/pages/massenbestellung" class="button button--secondary">
          {%- if is_german -%}Massenbestellung{%- else -%}Bulk order{%- endif -%}
        </a>
        <a href="/pages/vororder" class="button button--secondary">
          {%- if is_german -%}Vororder{%- else -%}Pre-order{%- endif -%}
        </a>
        <a href="/pages/haendlerbereich" class="button button--secondary">
          {%- if is_german -%}Meine Bestellungen &amp; Konto{%- else -%}My orders &amp; account{%- endif -%}
        </a>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Kunden-Willkommensleiste",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Kunden-Willkommensleiste"
    }
  ]
}
{% endschema %}
