{% comment %}
  Produktübergreifende Sammelbestellung: listet alle Produkte einer Collection
  mit ihren Größenvarianten in einer einzigen Tabelle, damit ein Händler nicht
  jede Produktseite einzeln öffnen muss (Master-Prompt §24 "Quick Order").

  Baut auf denselben Bausteinen wie die Quick-Order-Liste auf der einzelnen
  Produktseite auf (`snippets/quick-order-list-row.liquid`, dasselbe
  `<quick-order-list>` Custom Element/JS), gruppiert die Zeilen aber nach
  Produkt und zeigt die Gesamtsumme des ganzen Warenkorbs statt nur eines
  einzelnen Produkts.
{% endcomment %}

{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign b2b_price_visible = false
  if customer and customer.tags contains 'dealer-approved'
    assign b2b_price_visible = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if b2b_price_visible -%}
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>

  {%- liquid
    assign collection = collections[section.settings.collection]
    assign items_in_cart = cart.item_count

    comment
      Vororder-Betrieb: dieselbe Tabelle, aber mit Mindestmenge je Artikel.
      Ohne die Einstellung verhaelt sich der Abschnitt wie bisher.
    endcomment
    comment
      Bewusst ohne Vorbelegung: bleibt die Variable leer, greift in
      quantity-input der default-Filter und es gilt wie bisher das
      5er-Gebinde. Eine 0 waere in Liquid wahr und wuerde den default
      ueberspringen - dann stuende dort gar keine Mindestmenge.
    endcomment
    if section.settings.b2b_vororder
      assign zeilen_mindestmenge = section.settings.b2b_mindestmenge
    endif
  -%}

    {%- if section.settings.b2b_vororder -%}
      {%- comment -%}
        Der Stichtag wird gerechnet, nicht gepflegt - dieselben zwei festen
        Termine wie in sections/b2b-konditionen.liquid. Steht der Termin an
        zwei Stellen als Text, laeuft eine davon irgendwann ab.
      {%- endcomment -%}
      {%- liquid
        assign heute = 'now' | date: '%Y%m%d' | plus: 0
        assign jahr = 'now' | date: '%Y' | plus: 0
        assign termin_juni = jahr | times: 10000 | plus: 615
        assign termin_dezember = jahr | times: 10000 | plus: 1215

        if heute <= termin_juni
          assign termin_text = '15. Juni'
          assign termin_jahr = jahr
        elsif heute <= termin_dezember
          assign termin_text = '15. Dezember'
          assign termin_jahr = jahr
        else
          assign termin_text = '15. Juni'
          assign termin_jahr = jahr | plus: 1
        endif
        assign termin_voll = termin_text | append: ' ' | append: termin_jahr
      -%}

      <div class="b2b-vororder-kopf page-width">
        <p class="b2b-vororder-kopf__marke">Vororder</p>
        <h1 class="b2b-vororder-kopf__titel">{{ section.settings.b2b_titel | escape }}</h1>
        <ul class="b2b-vororder-kopf__regeln">
          <li><strong>10 % Rabatt</strong> auf die ganze Vororder</li>
          <li><strong>{{ section.settings.b2b_mindestmenge }} Packs</strong> Mindestmenge je Artikel</li>
          <li>Annahmeschluss <strong>{{ termin_voll }}</strong></li>
        </ul>
      </div>
    {%- endif -%}

  <div class="quick-order-list-container color-{{ section.settings.color_scheme }} gradient">
    <quick-order-list
      class="page-width section-{{ section.id }}-padding"
      id="{{ section.id }}"
      data-section="{{ section.id }}"
      data-product-id="catalog"
      data-url="{{ request.path }}"
    >
      {%- if section.settings.b2b_vororder -%}
      {%- comment -%}
        Sortierung. Sie greift im Browser und ordnet die Bloecke der
        angezeigten Seite um - nicht den ganzen Katalog. Grund: Shopify gibt
        Liquid hoechstens 50 Produkte je Seite, und Abfrageparameter aus der
        URL sind in Liquid gar nicht lesbar. Bei 108 Produkten und 50 je
        Seite sind das drei Seiten.
      {%- endcomment -%}
      <div class="b2b-vororder-leiste page-width">
        <label class="b2b-vororder-leiste__label" for="b2b-sortierung-{{ section.id }}">
          Sortieren nach
        </label>
        <select class="b2b-vororder-leiste__wahl" id="b2b-sortierung-{{ section.id }}">
          <option value="standard">Reihenfolge des Katalogs</option>
          <option value="name">Name A–Z</option>
          <option value="preis-auf">Preis aufsteigend</option>
          <option value="preis-ab">Preis absteigend</option>
          <option value="lager">Verfügbarkeit</option>
          <option value="art">Produktart</option>
        </select>
      </div>
      {%- endif -%}

      <form
        action="{{ routes.cart_update_url }}"
        class="quick-order-list__contents critical-hidden"
        method="post"
        id="QuickOrderList"
      >
        {% paginate collection.products by section.settings.products_per_page %}
          <div class="quick-order-list__container" id="main-variant-items">
            <table class="quick-order-list__table">
              <caption class="visually-hidden">
                {{ 'sections.catalog_order_list.heading' | t }}
              </caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" scope="col">
                    {{ 'sections.quick_order_list.variant' | t }}
                  </th>
                  <th class="large-up-hide right caption-with-letter-spacing" scope="col">
                    {{ 'sections.quick_order_list.variant_total' | t }}
                  </th>
                  <th
                    class="quick-order-list__table-heading--wide small-hide medium-hide caption-with-letter-spacing"
                    scope="col"
                  >
                    {{ 'products.product.quantity.label' | t }}
                  </th>
                  <th
                    class="quick-order-list__table-heading--wide small-hide medium-hide caption-with-letter-spacing"
                    scope="col"
                  >
                    {{ 'sections.cart.headings.price' | t }}
                  </th>
                  <th class="small-hide medium-hide right caption-with-letter-spacing" scope="col">
                    {{ 'sections.quick_order_list.variant_total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- for product in collection.products -%}
                  {%- comment -%}
                    Die Kennwerte, nach denen die Sortierung greift. Sie
                    stehen an der Produktzeile, weil die Sortierung ganze
                    Bloecke verschiebt - Produktzeile samt ihrer Varianten.
                  {%- endcomment -%}
                  {%- liquid
                    assign lager = 0
                    for v in product.variants
                      assign lager = lager | plus: v.inventory_quantity
                    endfor
                  -%}
                  <tr
                    class="catalog-order-list__product-row"
                    data-b2b-name="{{ product.title | escape }}"
                    data-b2b-preis="{{ product.price_min }}"
                    data-b2b-art="{{ product.type | default: '' | escape }}"
                    data-b2b-lager="{{ lager }}"
                  >
                    {%- render 'quick-order-product-row', item: product, image: product.featured_media -%}
                  </tr>
                  {%- for variant in product.variants -%}
                    {%- assign row_image = variant.image | default: product.featured_media -%}
                    {%- render 'quick-order-list-row',
                      item: variant,
                      product_title: product.title,
                      image: row_image,
                      sku: variant.sku,
                      variant: variant,
                      show_image: false,
                      show_sku: section.settings.show_sku,
                      is_modal: false,
                      mindestmenge: zeilen_mindestmenge,
                      ohne_lagergrenze: section.settings.b2b_vororder
                    -%}
                  {%- endfor -%}
                {%- else -%}
                  <tr>
                    <td colspan="5">{{ 'sections.catalog_order_list.no_products' | t }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          <div class="js-paginate">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endpaginate -%}

        <p
          class="visually-hidden"
          id="quick-order-list-live-region-text-catalog"
          aria-live="polite"
          role="status"
        ></p>
        <p
          class="visually-hidden"
          id="shopping-cart-variant-item-status"
          aria-live="polite"
          aria-hidden="true"
          role="status"
        >
          {{ 'accessibility.loading' | t }}
        </p>
      </form>

      <div class="quick-order-list__total gradient" id="quick-order-list-total-catalog-{{ section.id }}">
        <div class="quick-order-list-total__info">
          <div class="quick-order-list-total__column small-hide medium-hide">
            <div class="quick-order-list-buttons">
              <a href="{{ routes.cart_url }}" class="quick-order-list__button button button--secondary small-hide medium-hide">
                <span class="quick-order-list__button-text">{{- 'sections.quick_order_list.view_cart' | t -}}</span>
              </a>
            </div>
            <span class="quick-order-list__message caption-large" role="status">
              <span class="quick-order-list__message-icon hidden">
                <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
              </span>
              <span class="quick-order-list__message-text"></span>
            </span>
            <span class="quick-order-list-error"></span>
          </div>
          <div class="quick-order-list__total-items">
            <span>{{ items_in_cart }}</span>
            <p class="h5">{{ 'sections.quick_order_list.total_items' | t }}</p>
          </div>
          <div class="quick-order-list-total__price">
            <div class="totals__product-total">
              <span class="totals__subtotal-value">{{ cart.total_price | money }}</span>
              <p class="totals__subtotal h5">{{ 'sections.catalog_order_list.cart_total' | t }}</p>
            </div>
          </div>
          <div class="quick-order-list-total__column large-up-hide">
            <div class="quick-order-list-buttons">
              <a href="{{ routes.cart_url }}" class="quick-order-list__button button button--secondary button--full-width">
                <span class="quick-order-list__button-text">{{- 'sections.quick_order_list.view_cart' | t -}}</span>
              </a>
            </div>
            <span class="quick-order-list__message caption-large" role="status">
              <span class="quick-order-list__message-icon hidden">
                <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
              </span>
              <span class="quick-order-list__message-text"></span>
            </span>
            <span class="quick-order-list-error"></span>
          </div>
        </div>

        <script type="application/json" data-cart-contents>
          {{ cart.items | map: 'variant_id' | json }}
        </script>
      </div>
    </quick-order-list>
    <template id="QuickOrderListErrorTemplate-catalog">
      <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
      <span class="quick-order-list-error-message caption-large" role="alert"></span>
    </template>
  </div>
  {%- if section.settings.b2b_vororder -%}
    <style>
      .b2b-vororder-kopf { margin-bottom: 28px; }
      .b2b-vororder-kopf__marke {
        margin: 0 0 6px;
        color: rgb(var(--b2b-akzent, 199 42 9));
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .b2b-vororder-kopf__titel { margin: 0 0 16px; }
      .b2b-vororder-kopf__regeln {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .b2b-vororder-kopf__regeln li {
        padding: 10px 16px;
        border: 1px solid rgb(var(--b2b-linie, 226 226 225));
        border-radius: 8px;
        background: rgb(var(--b2b-hell, 246 246 246));
        font-size: 15px;
        line-height: 1.4;
      }
      /* ---- Sortierleiste ---- */
      .b2b-vororder-leiste {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 14px;
        margin-bottom: 20px;
      }
      .b2b-vororder-leiste__label {
        font-size: 15px;
        font-weight: 700;
      }
      .b2b-vororder-leiste__wahl {
        min-height: 44px;
        padding: 0 40px 0 14px;
        border: 1px solid rgb(var(--b2b-linie, 226 226 225));
        border-radius: 6px;
        background: rgb(255 255 255);
        font-size: 15px;
        line-height: 1.4;
      }

      /* ---- Produktbild ----
         Das Theme deckelt den Bildkasten auf 4.5rem (45px). Fuer die Vororder
         ist das Bild die einzige Orientierung ueber 108 Artikel hinweg,
         deshalb hier 72px - und contain statt cover, weil Socken auf Weiss
         sonst angeschnitten werden. */
      #{{ section.id }} .variant-item__media,
      #{{ section.id }} .variant-item__image-container {
        width: 72px;
        height: 72px;
      }
      #{{ section.id }} .variant-item__image {
        object-fit: contain;
      }

      /* ---- Warenkorbknopf ----
         Rot statt grau: es ist der Abschluss der Vororder und der einzige
         Weg weiter. */
      #{{ section.id }} .quick-order-list__button.button {
        border-color: rgb(var(--b2b-akzent, 199 42 9));
        background: rgb(var(--b2b-akzent, 199 42 9));
        color: rgb(255 255 255);
      }
      #{{ section.id }} .quick-order-list__button.button::before,
      #{{ section.id }} .quick-order-list__button.button::after {
        box-shadow: none;
      }
      @media (hover: hover) and (pointer: fine) {
        #{{ section.id }} .quick-order-list__button.button:hover {
          background: rgb(160 33 7);
          color: rgb(255 255 255);
        }
      }

      /* ---- Rueckfrage, wenn schon eine normale Bestellung im Korb liegt ---- */
      .b2b-vororder-frage {
        margin-bottom: 20px;
        padding: 16px 20px;
        border: 1px solid rgb(var(--b2b-akzent, 199 42 9) / 0.35);
        border-left: 5px solid rgb(var(--b2b-akzent, 199 42 9));
        border-radius: 8px;
        background: rgb(var(--b2b-akzent, 199 42 9) / 0.06);
      }
      .b2b-vororder-frage p {
        margin: 0 0 12px;
        font-size: 15px;
        line-height: 1.5;
      }
      .b2b-vororder-frage__knopf {
        padding: 11px 22px;
        border: 1px solid rgb(var(--b2b-akzent, 199 42 9));
        border-radius: 6px;
        background: rgb(var(--b2b-akzent, 199 42 9));
        color: rgb(255 255 255);
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
      }
      .b2b-vororder-frage__knopf[disabled] { opacity: 0.5; }

      /* Der Hinweis unter der Tabelle, solange eine Position zu klein ist. */
      .b2b-vororder-sperre {
        margin: 0 0 12px;
        padding: 12px 16px;
        border-left: 4px solid rgb(var(--b2b-akzent, 199 42 9));
        background: rgb(var(--b2b-akzent, 199 42 9) / 0.08);
        font-size: 15px;
        line-height: 1.4;
      }
      .b2b-vororder-sperre[hidden] { display: none; }
      .b2b-vororder-gesperrt {
        pointer-events: none;
        opacity: 0.45;
      }
    </style>

    <script>
      (function () {
        var MINDEST = {{ section.settings.b2b_mindestmenge | json }};
        var TERMIN = {{ termin_voll | json }};
        var wurzel = document.getElementById({{ section.id | json }});
        if (!wurzel) return;

        /* Das Warenkorb-Merkmal ist das einzige, was der Rabatt-Function und
           der Checkout-Pruefung sagt, dass dies eine Vororder ist. Es haengt
           am ganzen Warenkorb, nicht an einzelnen Positionen - /cart/update.js
           mit updates[] kann keine Positions-Merkmale setzen.

           Deshalb wird hier nicht blind gesetzt: liegt schon Ware im
           Warenkorb, die keine Vororder ist, wuerde sie stillschweigend zur
           Vororder und damit in eine ganz andere Lieferzeit rutschen. In dem
           Fall erst fragen. */
        var LAEUFT_SCHON = {{ cart.attributes.Vororder | json }};
        var IM_KORB = {{ cart.item_count | json }};

        function merkmalSetzen() {
          return fetch('{{ routes.cart_update_url }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ attributes: { Vororder: TERMIN } })
          });
        }

        if (!LAEUFT_SCHON && IM_KORB > 0) {
          var frage = document.createElement('div');
          frage.className = 'b2b-vororder-frage';
          frage.innerHTML =
            '<p><strong>In deinem Warenkorb liegt schon eine normale Bestellung.</strong> ' +
            'Eine Vororder wird Wochen spaeter geliefert, beides zusammen laesst sich ' +
            'nicht in einer Lieferung ausgeben.</p>';

          var knopf = document.createElement('button');
          knopf.type = 'button';
          knopf.className = 'b2b-vororder-frage__knopf';
          knopf.textContent = 'Warenkorb leeren und Vororder beginnen';
          knopf.addEventListener('click', function () {
            knopf.disabled = true;
            fetch('{{ routes.cart_clear_url }}.js', { method: 'POST' })
              .then(merkmalSetzen)
              .then(function () { window.location.reload(); });
          });
          frage.appendChild(knopf);

          var ziel = wurzel.querySelector('.b2b-vororder-leiste') || wurzel.firstChild;
          wurzel.insertBefore(frage, ziel);
        } else if (!LAEUFT_SCHON) {
          merkmalSetzen().catch(function () {
            /* Schlaegt das fehl, ist die Bestellung eine normale - unschoen,
               aber besser als eine Maske, die nicht mehr reagiert. */
          });
        }


        var hinweis = document.createElement('p');
        hinweis.className = 'b2b-vororder-sperre';
        hinweis.setAttribute('role', 'status');
        hinweis.hidden = true;

        var summe = wurzel.querySelector('.quick-order-list__total');
        if (summe) summe.insertBefore(hinweis, summe.firstChild);

        /* Geprueft wird gegen die Felder der Maske, nicht gegen den
           Warenkorb: was der Haendler gerade eingetippt hat, steht dort
           frueher als in cart.js. */
        function pruefe() {
          var felder = wurzel.querySelectorAll('.quantity__input');
          var zuklein = [];
          for (var i = 0; i < felder.length; i++) {
            var menge = parseInt(felder[i].value, 10);
            if (menge > 0 && menge < MINDEST) zuklein.push(menge);
          }

          hinweis.hidden = zuklein.length === 0;
          if (zuklein.length) {
            hinweis.textContent =
              zuklein.length === 1
                ? 'Eine Position liegt unter ' + MINDEST + ' Packs. Fuer eine Vororder braucht jeder Artikel mindestens ' + MINDEST + ' Packs.'
                : zuklein.length + ' Positionen liegen unter ' + MINDEST + ' Packs. Fuer eine Vororder braucht jeder Artikel mindestens ' + MINDEST + ' Packs.';
          }

          var knoepfe = wurzel.querySelectorAll('.quick-order-list__button');
          for (var k = 0; k < knoepfe.length; k++) {
            knoepfe[k].classList.toggle('b2b-vororder-gesperrt', zuklein.length > 0);
            knoepfe[k].setAttribute('aria-disabled', zuklein.length > 0 ? 'true' : 'false');
          }
        }

        /* ---- Sortierung ----
           Verschoben werden ganze Bloecke: eine Produktzeile und alle
           Variantenzeilen, die ihr folgen. Die Kennwerte stehen als
           data-Attribute an der Produktzeile. */
        var wahl = document.getElementById('b2b-sortierung-' + {{ section.id | json }});

        function bloecke(koerper) {
          var gruppen = [];
          var aktuell = null;
          var kinder = koerper.children;
          for (var i = 0; i < kinder.length; i++) {
            var zeile = kinder[i];
            if (zeile.hasAttribute('data-b2b-name')) {
              aktuell = { kopf: zeile, zeilen: [zeile] };
              gruppen.push(aktuell);
            } else if (aktuell) {
              aktuell.zeilen.push(zeile);
            }
          }
          return gruppen;
        }

        function sortiere() {
          if (!wahl) return;
          var koerper = wurzel.querySelector('.quick-order-list__table tbody');
          if (!koerper) return;

          var gruppen = bloecke(koerper);
          if (gruppen.length < 2) return;

          /* Die Ausgangsreihenfolge einmal festhalten, damit "Reihenfolge des
             Katalogs" auch nach mehrmaligem Umsortieren wieder stimmt. */
          gruppen.forEach(function (g, i) {
            if (g.kopf.dataset.b2bRang === undefined) g.kopf.dataset.b2bRang = i;
          });

          var art = wahl.value;
          var zahl = function (g, feld) { return parseInt(g.kopf.dataset[feld], 10) || 0; };
          var text = function (g, feld) { return (g.kopf.dataset[feld] || '').toLowerCase(); };

          gruppen.sort(function (a, b) {
            switch (art) {
              case 'name':
                return text(a, 'b2bName').localeCompare(text(b, 'b2bName'), 'de');
              case 'preis-auf':
                return zahl(a, 'b2bPreis') - zahl(b, 'b2bPreis');
              case 'preis-ab':
                return zahl(b, 'b2bPreis') - zahl(a, 'b2bPreis');
              case 'lager':
                return zahl(b, 'b2bLager') - zahl(a, 'b2bLager');
              case 'art':
                /* Innerhalb derselben Produktart nach Namen, sonst stehen
                   85 Tennissocken in zufaelliger Folge. */
                return (
                  text(a, 'b2bArt').localeCompare(text(b, 'b2bArt'), 'de') ||
                  text(a, 'b2bName').localeCompare(text(b, 'b2bName'), 'de')
                );
              default:
                return zahl(a, 'b2bRang') - zahl(b, 'b2bRang');
            }
          });

          var neu = document.createDocumentFragment();
          gruppen.forEach(function (g) {
            g.zeilen.forEach(function (z) { neu.appendChild(z); });
          });
          koerper.appendChild(neu);
        }

        if (wahl) wahl.addEventListener('change', sortiere);

        wurzel.addEventListener('input', pruefe);
        wurzel.addEventListener('change', pruefe);

        /* Die Liste baut sich nach jeder Warenkorbaenderung neu auf: die
           Felder werden ersetzt und die Reihenfolge steht wieder auf
           Katalog. Deshalb beobachten und beides nachziehen.

           Waehrend des Sortierens abgemeldet, sonst loest das Umhaengen der
           Zeilen den Beobachter aus, der wieder sortiert - eine Schleife. */
        var beobachter = new MutationObserver(function () {
          pruefe();
          beobachter.disconnect();
          sortiere();
          beobachter.observe(wurzel, { childList: true, subtree: true });
        });
        beobachter.observe(wurzel, { childList: true, subtree: true });

        pruefe();
      })();
    </script>
  {%- endif -%}

{%- else -%}
  <div class="quick-order-list-login-gate page-width section-{{ section.id }}-padding">
    {% render 'b2b-freigabe-link', klasse: 'button button--secondary' %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.catalog-order-list.name",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Vororder"
    },
    {
      "type": "checkbox",
